# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (SQLite by default; swap to a Postgres URL for production) ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email (SMTP via Nodemailer; works with SendGrid/Mailgun/Gmail SMTP relay) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM="Clinic Manager <no-reply@clinic.example.com>"

# --- Google Calendar OAuth2 ---
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# --- Frontend origin (CORS) ---
FRONTEND_URL=http://localhost:5173
